{% extends 'base.html.twig' %}
{% import 'theme/macro.html.twig' as m %}

{% set title = 'game.index.title'|trans %}

{% block main %}
  <section>
    <div class="container">
      {{ m.attachment_modal() }}

      {# Redefine the flashes with the same width as the cards #}
      <div class="mx-auto card-max-large card-max-md-none">
        {{ block('flash', 'theme/flash.html.twig') }}
      </div>

      {# Button to add a new game #}
      <div class="mx-auto card-max-large card-max-md-none text-center mt-2 mb-4">
        <a href="{{ path('game_new') }}" class="btn btn-primary" data-turbo-frame="_top" aria-label="{{ 'game.index.button.addGame'|trans }}">
          <span class="bi bi-plus-square-fill me-md-1" aria-hidden="true"></span>
          <span>{{ 'game.index.button.addGame'|trans }}</span>
        </a>
      </div>

      {# Turboframe to refresh only the main section when sorting the results #}
      <turbo-frame id="main-section">
        {# Number of games added in the app #}
        <div class="mx-auto card-max-large card-max-md-none text-start fw-light mb-2">
          {{ 'game.index.numberDisplayed'|trans({ displayed: numbers.displayed, total: numbers.total }) }}
        </div>

        {# Prepare the filters content #}
        {% set filterContentTypeGame %}
          <ul class="p-0 m-0">
            {% for typeGame in enum('App\\Enum\\TypeGameEnum').cases %}
              {% set checked = queryParam.filters.typeGame is not defined or typeGame.value in queryParam.filters.typeGame %}
              {% set filtersTypeGameId = 'filters-type-game-' ~ (typeGame.value|lower) %}
              <li class="dropdown-item {{ checked ? 'active' }}">
                <input
                  class="form-check-input"
                  type="checkbox"
                  value="{{ typeGame.value }}"
                  id="{{ filtersTypeGameId }}"
                  {{ checked ? 'checked' }}
                  data-filter-apply-target="checkbox"
                />
                <label class="form-check-label w-100" for="{{ filtersTypeGameId }}">{{ typeGame|trans }}</label>
              </li>
            {% endfor %}
          </ul>
        {% endset %}
        {% set filterContentUsers %}
          <ul class="p-0 m-0">
            {% for user in users|filter(u => u is not null)|sort((a, b) => a.username <=> b.username) %}
              {% set checked = queryParam.filters.users is not defined or user.id in queryParam.filters.users %}
              {% set filtersUserId = 'filters-users-' ~ user.id %}
              <li class="dropdown-item {{ checked ? 'active' }}">
                <input class="form-check-input" type="checkbox" value="{{ user.id }}" id="{{ filtersUserId }}" {{ checked ? 'checked' }} data-filter-apply-target="checkbox" />
                <label class="form-check-label w-100" for="{{ filtersUserId }}">
                  {{ m.user_avatar(user) }}
                  <span class="ms-1">{{ user.username }}</span>
                </label>
              </li>
            {% endfor %}
          </ul>
        {% endset %}

        {% set filterContentWithoutReview %}
          <ul class="p-0 m-0">
            {% set checked = queryParam.filters.withoutReview is defined and queryParam.filters.withoutReview is not empty %}
            {% set filtersWithoutReviewId = 'filters-without-review' %}
            <li class="dropdown-item {{ checked ? 'active' }}">
              <input class="form-check-input" type="checkbox" value="1" id="{{ filtersWithoutReviewId }}" {{ checked ? 'checked' }} data-filter-apply-target="checkbox" />
              <label class="form-check-label w-100" for="{{ filtersWithoutReviewId }}">Afficher les jeux sans avis</label>
            </li>
          </ul>
        {% endset %}
        {# Include the buttons to sort, filter and reset #}
        {{
          m.index_buttons(
            queryParam,
            'game',
            ['name', 'avgRating', 'totHourSpend', 'minFirstPlay'],
            { typeGame: filterContentTypeGame, users: filterContentUsers, withoutReview: filterContentWithoutReview }
          )
        }}

        {# Include the template to render the card of each game + show more button #}
        {{ include('game/_list.html.twig') }}
      </turbo-frame>
    </div>
  </section>
{% endblock %}
