{% from 'theme/macro.html.twig' import fmt_avg_rating %}

{% set game = object.game %}

<div class="d-flex gap-2">
  <div class="card-flex-small card-flex-md-medium">
    {% if game.imgUrl is not empty %}
      <img src="{{ game.imgUrl }}" class="app-card-img-fit" alt="{{ 'aria.cover'|trans({ name: game.name }) }}" />
    {% else %}
      <div class="bi bi-image text-center app-card-img-fit app-card-img-missing-search bg-body-secondary" aria-hidden="true"></div>
    {% endif %}
  </div>
  <div class="d-flex flex-column text-truncate">
    <div class="fw-bold">
      {{ game.name }} <small>({{ game.releaseYear }})</small>
    </div>
    <div class="fw-light lh-sm">
      {{ 'home.index.search.reviewedBy'|trans }} : {{ game.reviews|map(r => r.user.username)|sort|join(', ') }}<br />
      {{ 'home.index.search.avgRating'|trans }} : {{ fmt_avg_rating(object.avgRating) }} <span class="fa-regular fa-star fa-sm" aria-hidden="true"></span>
    </div>
  </div>
</div>
