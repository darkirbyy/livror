{% extends 'base.html.twig' %}
{% import 'theme/macro.html.twig' as m %}

{% set title = 'game.show.title'|trans %}

{% block main %}
  <section>
    <div class="container">
      {# Redefine the flashes with the same width as the cards #}
      <div class="mx-auto card-max-large card-max-md-none">
        {{ block('flash', 'theme/flash.html.twig') }}
      </div>

      {# Back link #}
      {{ m.backlink(path('home_index')) }}

      {# Game card #}
      {% set backpath = path('game_show', { id: gameInfo.game.id }) %}
      {{ include('game/_card.html.twig') }}

      {# Link to check all games list #}
      <div class="text-center py-4">
        <a href="{{ path('game_index') }}" class="btn btn-outline-secondary">{{ 'game.show.button.allGame'|trans }}</a>
      </div>
    </div>
  </section>
{% endblock %}
