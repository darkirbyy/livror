{% extends 'base.html.twig' %}
{% import 'theme/macro.html.twig' as m %}

{% set title = 'game.show.title'|trans({ name: gameInfo.game.name }) %}

{% block main %}
  <section>
    <div class="container">
      {# Redefine the flashes and backlink with the same width as the cards #}
      <div class="mx-auto card-max-large card-max-md-none">
        {{ block('flash', 'theme/flash.html.twig') }}
        {{ m.backlink(path('game_index')) }}
      </div>

      {# Game card #}
      {% set backpath = path('game_show', { id: gameInfo.game.id }) %}
      {% set collapsed = false %}
      {{ include('game/_card.html.twig') }}
    </div>
  </section>
{% endblock %}
