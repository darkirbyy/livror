{% import 'theme/macro.html.twig' as m %}

{% if (gamesInfo|length) > 0 %}
  <div {{ stimulus_controller('load-popover') }}>
    {% for gameInfo in gamesInfo %}
      {% set backpath = m.path_with_query_param(queryParam|clone_with({ offset: 0, limit: queryParam.limit + queryParam.offset }), 'game-' ~ gameInfo.game.id) %}

      {{ include('game/_card.html.twig') }}
    {% endfor %}
  </div>

  {% if hasMore %}
    {{ m.more_button(queryParam) }}
  {% endif %}
{% else %}
  <div class="card-max-large card-max-md-none mx-auto my-1 p-2 fs-5 fw-light">
    {{ 'game.index.notFound'|trans }}
  </div>
{% endif %}
