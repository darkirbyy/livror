{# #################################### #}
{# ## Format ########################## #}
{# #################################### #}

{# Macro to display the price #}
{%- macro fmt_full_price(fullPrice) -%}
  {{ fullPrice > 0 ? (fullPrice / 100)|format_currency(env.app.currency, { decimal_always_shown: true, fraction_digit: 2 }) : fullPrice|to_type_price|trans }}
{%- endmacro -%}

{# Macro to display the number of users having reviewed that game #}
{%- macro fmt_num_users(numUsers) -%}
  {{ numUsers != 0 ? numUsers : '-' }}
{%- endmacro -%}

{# Macro to display the average rating #}
{%- macro fmt_avg_rating(avgRating) -%}
  {{ avgRating is not empty ? avgRating|format_number({ fraction_digit: 2 }) : '-' }}
{%- endmacro -%}

{# Macro to display the total hour spend #}
{%- macro fmt_tot_hour_spend(totHourSpend) -%}
  {{ totHourSpend is not empty ? totHourSpend ~ 'h' : '-' }}
{%- endmacro -%}

{# Macro to display the min of the first play date #}
{%- macro fmt_min_first_play(minFirstPlay) -%}
  {{ minFirstPlay is not empty ? minFirstPlay|format_datetime('short', 'none') : '-' }}
{%- endmacro -%}

{# #################################### #}
{# ## Forms ########################### #}
{# #################################### #}

{# Macro to prepare the delete modal in the form #}
{% macro form_modal(body, path) %}
  <div class="modal" id="delete-modal" tabindex="-1" aria-labelledby="delete-modal-label" aria-hidden="true" role="dialog" loading="lazy">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        {# Header with title and dismiss button #}
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="delete-modal-label">{{ 'form.modal.deleteTitle'|trans }}</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'form.button.close'|trans }}"></button>
        </div>

        {# Body with message #}
        <div class="modal-body">
          {{ body|raw }}
        </div>

        {# Footer with cancel or confirm buttons #}
        <div class="modal-footer">
          <form action="{{ path }}" method="post">
            <button type="submit" class="btn btn-danger">
              <span class="lnr lnr-trash me-1" aria-hidden="true"></span>
              {{ 'form.button.delete'|trans }}
            </button>
            <input type="hidden" name="_token" data-controller="csrf-protection" value="{{ csrf_token('livror/delete') }}" />
          </form>
        </div>
      </div>
    </div>
  </div>
{% endmacro %}

{# Macro to display the submit button and the delete button if in edit mode #}
{% macro form_buttons(form, isEditMode) %}
  <div class="d-flex justify-content-between">
    {# Left part : submit #}
    <div>
      {{ form_widget(form.submit, { label: isEditMode ? 'form.button.update' : 'form.button.add' }) }}
    </div>
    {# Right part (if in EDIT mode) : open delete modal #}
    {% if isEditMode %}
      <div>
        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#delete-modal">
          <span class="lnr lnr-trash me-1" aria-hidden="true"></span>
          {{ 'form.button.delete'|trans }}
        </button>
      </div>
    {% endif %}
  </div>
{% endmacro %}

{# #################################### #}
{# ## Content ######################### #}
{# #################################### #}

{% macro index_buttons(queryParam, entityKey, displayedSortsKeys, filterContent) %}
  <div class="card-max-large card-max-md-none mx-auto">
    <div class="d-flex flex-wrap align-items-end justify-content-between gap-2">
      {# Fields to sort : prepare variables + independant buttons (large screen) or select (small screen) for each possibility + asc/desc button #}
      <div class="flex-md-fill {{ displayedSortsKeys is empty ? 'd-none' }}">
        {# prepare variables #}
        {% set sorts = [] %}
        {% for sortKey in displayedSortsKeys %}
          {% set new_param = { offset: 0, limit: env.app.default_limit, sorts: { (sortKey): queryParam.sorts|first } } %}
          {% set sort = {
            key: sortKey,
            url: _self.path_with_query_param(queryParam|clone_with(new_param)),
            active: (queryParam.sorts|keys|first) == sortKey,
            label: (entityKey ~ '.index.sort.' ~ sortKey)|trans
          } %}
          {% set sorts = sorts|merge([sort]) %}
        {% endfor %}
        <div class="input-group" role="group" aria-labelledby="input-group-sorts">
          <label class="input-group-text" id="input-group-sorts">{{ 'form.button.sortBy'|trans }}</label>
          {# independant buttons (large screen) #}
          {% for sort in sorts %}
            <a href="{{ sort.url }}" class="btn btn-outline-light app-btn-input-border  d-none d-md-block {{ sort.active ? 'active' }}" data-turbo-prefetch="false">
              {{ sort.label }}
            </a>
          {% endfor %}
          {# select (small screen) #}
          <select class="form-select d-md-none" {{ stimulus_controller('sort-select') }}>
            {% for sort in sorts %}
              <option value="{{ sort.url }}" {{ sort.active ? 'selected="selected"' }}>
                {{ sort.label }}
              </option>
            {% endfor %}
          </select>
          {# asc/desc button #}
          {% set direction_way = queryParam.sorts|first %}
          {% set new_param = { offset: 0, limit: env.app.default_limit, sorts: { (queryParam.sorts|keys|first): direction_way == 'asc' ? 'desc' : 'asc' } } %}
          {% set direction_url = _self.path_with_query_param(queryParam|clone_with(new_param)) %}
          <a href="{{ direction_url }}" class="btn btn-outline-light app-btn-input-border" aria-label="{{ ('aria.order.' ~ direction_way)|trans }}" data-turbo-prefetch="false">
            <span class="lnr lnr-arrow-{{ direction_way == 'asc' ? 'up' : 'down' }}" aria-hidden="true"></span>
          </a>
        </div>
      </div>
      {# Fields to filter : dropdown with checkboxes for all possibilities and apply button #}
      <div class="app-filters {{ filterContent|keys is empty ? 'd-none' }}">
        <div class="input-group" role="group" aria-labelledby="input-group-filters">
          <label class="input-group-text" id="input-group-filters">{{ 'form.button.filterBy'|trans }}</label>
          {% for filterKey in filterContent|keys %}
            {% set filtersId = 'filters-' ~ filterKey %}
            {% set filter_not_empty = attribute(queryParam.filters, filterKey) is defined and attribute(queryParam.filters, filterKey) is not empty %}
            <button
              type="button"
              class="btn btn-outline-light app-btn-input-border dropdown-toggle app-dropdown-left {{ filter_not_empty ? 'active' }}"
              data-bs-toggle="dropdown"
              data-bs-target="#{{ filtersId }}"
              data-bs-auto-close="outside"
              aria-expanded="false"
              aria-haspopup="true"
            >
              {{ (entityKey ~ '.index.filter.' ~ filterKey)|trans }}
              {% if filter_not_empty %}
                {% set filter_size = attribute(queryParam.filters, filterKey)|length %}
                <sup><span class="bi bi-{{ filter_size < 10 ? filter_size : 'check' }}-square" aria-hidden="true"></span></sup>
              {% endif %}
            </button>
            {% set new_param = { offset: 0, limit: env.app.default_limit, filters: queryParam.filters|filter((value, key) => key != filterKey) } %}
            {% set url = _self.path_with_query_param(queryParam|clone_with(new_param)) %}
            <div id="{{ filtersId }}" class="dropdown-menu dropdown-menu-end" {{ stimulus_controller('filter-apply', { url: url, key: filterKey }) }}>
              {{ attribute(filterContent, filterKey) }}
              <div class="py-2 text-center">
                <button class="btn btn-sm btn-outline-light app-btn-input-border" data-filter-apply-target="button">{{ 'form.button.apply'|trans }}</button>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
      {# Field to reset #}
      <div>
        {% set reinit_url = _self.path_with_query_param(queryParam|clone_reset) %}
        <a href="{{ reinit_url }}" class="btn btn-outline-light app-btn-input-border" aria-label="{{ 'form.button.reset'|trans }}">
          <span class="lnr lnr-undo" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </div>
{% endmacro %}

{# Macro to display the title of the game in the game and review index #}
{%- macro game_title(game, backpath = null, show = false, edit = false) -%}
  <div class="text-center text-md-start p-1 position-relative">
    <div class="position-absolute end-0 float-end px-1 bg-primary bg-gradient">
      {% if edit %}
        {% set url = path('game_edit', { id: game.id, backpath: backpath }) %}
        <a href="{{ url }}" class="btn btn-sm btn-outline-light" aria-label="{{ 'game.index.button.editGame'|trans }}" data-turbo-frame="_top">
          <span class="lnr lnr-pencil" aria-hidden="true"></span>
        </a>
      {% endif %}
    </div>
    <h5 class="mb-0 p-1 text-truncate">
      {% set url = show ? path('game_show', { id: game.id, backpath: backpath }) : '#' %}
      <a href="{{ url }}" class="app-game-title" data-turbo-frame="_top">{{ game.name }}</a>
    </h5>
  </div>
{%- endmacro -%}

{# Macro to display the image of a game from the URL or a placeholder if empty #}
{%- macro game_image(game) -%}
  {% if game.imgUrl is not empty %}
    <img src="{{ game.imgUrl }}" class="app-card-img-fit" alt="{{ 'aria.cover'|trans({ name: game.name }) }}" />
  {% else %}
    <div class="lnr lnr-frame-expand text-center app-card-img-fit app-card-img-missing-index bg-body-secondary" aria-hidden="true"></div>
  {% endif %}
{%- endmacro -%}

{# Macro to display the information of a game #}
{%- macro game_information(game) -%}
  {% set gameData = {
    typeGame: game.typeGame|trans,
    releaseYear: game.releaseYear,
    fullPrice: _self.fmt_full_price(game.fullPrice),
    developers: game.developers,
    genres: game.genres,
    description: game.description
  } %}

  {% for field, value in gameData %}
    <div class="col-4 py-1 px-1 text-end text-truncate {{ field != 'description' ? 'border-bottom' : '' }}">
      <span class="fw-light">{{ ('game.label.' ~ field)|trans([], 'validators') }}</span>
    </div>
    <div class="col-8 py-1 text-start {{ (field not in ['genres', 'description'] ? 'text-truncate') ~ ' ' ~ (field != 'description' ? 'border-bottom') }}">
      {{ value|default('-') }}
    </div>
  {% endfor %}
{%- endmacro -%}

{# Macro to display the information of a review #}
{%- macro review_information(review, flexClass) -%}
  {% set baseClasses = 'flex-basis-0 p-2 h-100 border-start text-truncate focus-ring app-review-cell ' %}

  {% set popover = 'review.help.rating'|trans([], 'validators') %}
  <div role="button" class="{{ baseClasses ~ flexClass.rating }}" tabindex="0" data-bs-toggle="popover" data-bs-content="{{ popover|e }}">
    <span class="livror livror-rating" aria-hidden="true"></span>
    <span class="visually-hidden">{{ 'review.label.rating'|trans([], 'validators') }} :</span>
    {{ review.rating is not empty ? review.rating|format_number({ fraction_digit: 1 }) : '-' }}
  </div>

  {% set popover = 'review.help.hourSpend'|trans([], 'validators') %}
  <div role="button" class="{{ baseClasses ~ flexClass.hourSpend }}" tabindex="0" data-bs-toggle="popover" data-bs-content="{{ popover|e }}">
    <span class="lnr lnr-hourglass" aria-hidden="true"></span>
    <span class="visually-hidden">{{ 'review.label.hourSpend'|trans([], 'validators') }} :</span>
    {{ review.hourSpend is not empty ? review.hourSpend ~ 'h' : '-' }}
  </div>

  {% set popover = 'review.help.firstPlay'|trans([], 'validators') %}
  <div role="button" class="{{ baseClasses ~ flexClass.firstPlay }}" tabindex="0" data-bs-toggle="popover" data-bs-content="{{ popover|e }}">
    <span class="lnr lnr-calendar-full" aria-hidden="true"></span>
    <span class="visually-hidden">{{ 'review.label.firstPlay'|trans([], 'validators') }} :</span>
    <span class="small">{{ review.firstPlay is not empty ? review.firstPlay|format_datetime('short', 'none') : '-' }}</span>
  </div>
{%- endmacro -%}

{# Macro to display the body of a review (button to edit, date added, comment) #}
{% macro review_body(review, backpath = null, edit = false) %}
  {% if edit and review.user.id == app.user.id %}
    <div class="float-end">
      <a
        class="btn btn-sm btn-outline-light app-btn-input-border"
        href="{{ path('review_edit', { id: review.id, backpath: backpath }) }}"
        aria-label="{{ 'review.index.button.editReview'|trans }}"
        data-turbo-frame="_top"
      >
        <span class="lnr lnr-pencil" aria-hidden="true"></span>
        <span class="d-none d-md-inline">{{ 'review.index.button.editReview'|trans }}</span>
      </a>
    </div>
  {% endif %}
  <div class="px-1">
    <span class="small fw-light">
      {% set date_add = review.dateAdd|format_datetime('relative_medium', 'none') %}
      {% set date_update = review.dateUpdate|format_datetime('relative_medium', 'none') %}
      {{ 'review.index.card.added'|trans }} : {{ date_add }}
      {% if date_add != date_update %}
        ({{ 'review.index.card.updated'|trans }} : {{ date_update }})
      {% endif %}
    </span>
    <p class="m-0">
      {% if review.comment is not empty %}
        {{ review.comment|nl2br }}
      {% else %}
        <span class="fw-light">{{ 'review.index.card.noComment'|trans }}</span>
      {% endif %}
    </p>
    {% if (review.attachments|length) > 0 %}
      <div class="d-flex flex-row align-items-start my-1">
        <div class="text-nowrap">
          {{ 'review.label.attachments'|trans([], 'validators') }} :
        </div>
        <ul class="mb-0">
          {% for attachment in review.attachments %}
            <li>
              {{ attachment.description }} -
              <a data-turbo="false" href="{{ path('attachment_download', { id: attachment.id }) }}" class="link-light">{{ 'form.button.download'|trans }}</a>
              {% if attachment.fileMeta.mimeType starts with 'image/' %}
                - <a href="#" role="button" class="link-light" data-bs-toggle="modal" data-bs-target="#attachment-modal" data-bs-path="{{ path('attachment_download', { id: attachment.id }) }}" data-bs-title="{{ attachment.description }}">{{
                    'form.button.display'|trans
                  }}</a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  </div>
{% endmacro %}

{% macro attachment_modal() %}
  <div
    class="modal"
    id="attachment-modal"
    tabindex="-1"
    aria-labelledby="attachment-modal-label"
    aria-hidden="true"
    role="dialog"
    loading="lazy"
    {{ stimulus_controller('attachment-display') }}
  >
    <div class="modal-dialog modal-dialog-centered modal-xl">
      <div class="modal-content">
        {# Header with title and dismiss button #}
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="delete-modal-label" data-attachment-display-target="title"></h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'form.button.close'|trans }}"></button>
        </div>

        {# Body with image #}
        <div class="modal-body text-center p-2">
          <img class="img-fluid" data-attachment-display-target="image" src="" alt="Image" />
        </div>
      </div>
    </div>
  </div>
{% endmacro %}

{% macro user_avatar(user, size = 'sm') %}
  <img src="{{ user.avatarPath|generate_root }}" class="img-fluid app-avatar-{{ size }}" alt="{{ 'aria.avatar'|trans({ name: user.username }) }}" />
{% endmacro %}

{% macro user_popover(user) %}
  <div class="d-flex align-items-center gap-3">
    {{ _self.user_avatar(user, 'md') }}
    <div>
      <h6 class="fs-5 mb-0">{{ user.username }}</h6>
      <div class="mb-1">
        {{ 'review.index.numberPublished'|trans({ published: user.numberReviews }) }}
      </div>
      <a data-turbo-frame="_top" href="{{ path('review_index', { id: user.id }) }}" class="link-primary icon-link icon-link-hover icon-link-right">
        Voir les avis
        <span class="bi bi-arrow-right" aria-hidden="true"></span>
      </a>
    </div>
  </div>
{% endmacro %}

{# #################################### #}
{# ## Miscellaneous ################### #}
{# #################################### #}

{# Macro to lighten the code to generate path with query params #}
{%- macro path_with_query_param(queryParam, anchor = null) -%}
  {{- path(app.current_route, queryParam|to_array|merge({ anchor: anchor })|merge(app.current_route_parameters))|raw -}}
{%- endmacro -%}

{# Macro to create a backlink #}
{% macro backlink(path) %}
  <div class="mb-2">
    <a class="link-light icon-link icon-link-hover icon-link-left" href="{{ path|generate_backpath }}">
      <span class="bi bi-arrow-left mb-1" aria-hidden="true"></span>
      {{ 'form.button.goBack'|trans }}
    </a>
  </div>
{% endmacro %}

{# Macro to display and prepare the load more button #}
{% macro more_button(queryParam) %}
  {% set new_param = { offset: queryParam.offset + queryParam.limit, limit: env.app.default_limit } %}
  {% set url = _self.path_with_query_param(queryParam|clone_with(new_param)) %}
  <div class="text-center py-3" {{ stimulus_controller('load-more', { url: url, lazy: env.app.enable_autoload }) }}>
    <button class="btn btn-outline-light" data-load-more-target="button remove">{{ 'form.button.showMore'|trans }}</button>
    <span class="fs-4 text-muted" data-load-more-target="spinner"></span>
  </div>
{% endmacro %}

{# Macro to add classes to active element #}
{% macro active_class(active) %}
  {{- active ? 'active' -}}
{% endmacro %}

{# Macro to add attr to active element #}
{% macro active_attr(active) %}
  {{- active ? 'aria-current="page" aria-selected="true"' -}}
{% endmacro %}
