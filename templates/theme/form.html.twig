{% extends 'bootstrap_5_layout.html.twig' %}

{# #################################### #}
{# ## Global modifications ############ #}
{# #################################### #}

{# Simplify the standard row #}
{% block form_row_render %}
  {# Choose the tag depending on compound #}
  {%- if compound is defined and compound -%}
    {%- set element = 'fieldset' -%}
  {%- endif -%}

  {# Calculates the row_attr with `app-form-row` + `has_validation` (if errors) + custom row attributes #}
  {% set custom_classes = 'app-form-row' ~ ' ' ~ (not compound or (force_error|default(false)) ? (errors|length) > 0 ? 'has-validation') %}
  {% set attributes %}
    {% with { attr: row_attr|merge({ class: ((row_attr.class|default('')) ~ ' ' ~ custom_classes)|trim }) } %}
    {{ block('attributes') }}
    {% endwith %}
  {% endset %}

  {# Render the elements in this order : label, help, widget, error #}
  {# prettier-ignore-start #}
  {{ ('<' ~ element|default('div'))|raw }} {{ attributes }}>
  {{- form_label(form) -}}
  {{- form_help(form) -}}
  {{- form_widget(form, widget_attr) -}}
  {{- form_errors(form) -}}
  {{ ('</' ~ element|default('div'))|raw }}>
  {# prettier-ignore-end #}
{% endblock %}

{# Add .is-invalid on the container div #}
{% block choice_widget_expanded %}
  {% set attr = attr|merge({ class: ((attr.class|default('')) ~ (not compound or valid ? '' : ' is-invalid'))|trim }) %}

  <div {{ block('widget_container_attributes') }}>
    {%- for child in form %}
      {{- form_widget(child, { parent_label_class: label_attr.class|default(''), translation_domain: choice_translation_domain, valid: valid }) -}}
    {% endfor -%}
  </div>
{% endblock %}

{# Custom collection changes to add button and javascript controller #}
{# Add stimulus controller #}
{% block collection_row %}
  {% set custom_row_attr = { 'data-controller': 'collec-field' } %}
  {% set row_attr = row_attr|merge(custom_row_attr) %}
  {{- form_row(form, { row_attr: row_attr }) -}}
{% endblock %}

{# Add two mandatory targets and the add button #}
{% block collection_widget %}
  {% set custom_attr = { 'data-collec-field-target': 'collec' } %}
  {% set attr = attr|merge(custom_attr) %}
  <div class="form-control">
    {{- parent() -}}
    <button class="btn btn-outline-secondary" type="button" data-collec-field-target="add">
      <span class="bi bi-plus-square me-1" aria-hidden="true"></span>{{ 'form.button.add'|trans }}
    </button>
  </div>
{% endblock %}

{# Add one mandatory target and the delete button #}
{% block collection_entry_row %}
  <div class="d-flex gap-2" {{ block('attributes') }}>
    {% for row in form.children %}
      {{ form_row(row) }}
    {% endfor %}
    <button class="btn btn-outline-danger mt-4 app-btn-max-height" type="button" data-collec-field-target="remove" aria-label="{{ 'form.button.delete'|trans }}">
      <span class="bi bi-trash" aria-hidden="true"></span>
    </button>
  </div>
{% endblock %}

{# Customize vich uploader widget to add the stored file #}
{%- block vich_file_widget -%}
  <div class="vich-file">
    {%- if (errors|length) > 0 -%}
      {%- set attr = attr|merge({ class: ((attr.class|default('')) ~ ' is-invalid')|trim }) -%}
    {%- endif -%}
    {{- form_widget(form.file, { attr: attr }) -}}
    {%- if form.delete is defined -%}
      {{- form_row(form.delete) -}}
    {%- endif -%}

    {%- if download_uri -%}
      <span class="ps-2 fw-light">{{ 'form.file.stored'|trans }} :</span> {{ download_label }}
    {%- endif -%}
  </div>
{%- endblock -%}

{# #################################### #}
{# ## Specific modifications ########## #}
{# #################################### #}

{% block _game_steamId_widget %}
  {%- set type = 'text' -%}
  {{ block('form_widget_simple') }}
{% endblock %}

{% block _game_releaseYear_widget %}
  {%- set type = 'text' -%}
  {{ block('form_widget_simple') }}
{% endblock %}

{% block _review_hourSpend_widget %}
  {%- set type = 'text' -%}
  {{ block('form_widget_simple') }}
{% endblock %}

{% block _review_attachments_entry_file_row %}
  {{ form_row(form, { label: 'attachment.label.file', attr: { 'data-collec-field-target': 'focus' } }) }}
{% endblock %}

{% block _review_attachments_entry_description_row %}
  {{ form_row(form, { label: 'attachment.label.description', row_attr: { class: 'flex-fill' } }) }}
{% endblock %}
