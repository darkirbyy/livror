{# prettier-ignore-start #}
{{ 'discord.notify.intro'|trans }} **{{ 'layout.name'|trans }}** !
{% if (games|length) > 0 -%}
- {{ 'discord.notify.numberAddedGames'|trans({ number: games|length }) }} : {{ games|slice(0, ellipsis)|join(', ') ~ (games|length > ellipsis ? ', ...') }}
{% endif -%}

{%- for reviewsByUser in reviewsByUsers -%}
{% if (reviewsByUser.reviews|length) > 0 %}
- {{ 'discord.notify.numberPublishedReviewsBy'|trans({ number: reviewsByUser.reviews|length, name: reviewsByUser.user.username }) }} : {{ reviewsByUser.reviews|slice(0, ellipsis)|join(', ') ~ (games|length > ellipsis ? ', ...') }}
{% endif %}
{%- endfor -%}
{{ 'discord.notify.outro'|trans }} [{{ 'layout.name'|trans }}]({{- url -}})
{# prettier-ignore-end #}
