{# prettier-ignore-start #}
{{ ':book: ' ~ 'discord.notify.intro'|trans }} **{{ 'layout.name'|trans }}** !
{% if (games|length) > 0 -%}
- {{ 'discord.notify.numberAddedGames'|trans({ number: games|length }) }} : {{ games|slice(0, ellipsis)|join(', ') ~ (games|length > ellipsis ? ', ...') }}
{% endif -%}

{%- set maxNumberReviews = reviewsByUsers|map(reviewsByUser => reviewsByUser.reviews|length)|reduce((max, value) => value > max ? value : max, 0) -%}

{%- for reviewsByUser in reviewsByUsers -%}
{% if (reviewsByUser.reviews|length) > 0 %}
{{ '- ' ~ 'discord.notify.numberPublishedReviewsBy'|trans({ number: reviewsByUser.reviews|length, name: reviewsByUser.user.username }) -}}
{{- maxNumberReviews == (reviewsByUser.reviews|length) ? ' :trophy:' -}}
{{- ' : ' ~ reviewsByUser.reviews|slice(0, ellipsis)|join(', ') ~ (games|length > ellipsis ? ', ...') }}
{% endif %}
{%- endfor -%}

{%- if games|length + maxNumberReviews == 0 -%}
{{ 'discord.notify.nothingNew'|trans }} {{ 'discord.notify.writeYourReview'|trans }}
{%- else -%}
{{ 'discord.notify.checkOn'|trans }}
{%- endif -%}
{{ ' [' ~ 'layout.name'|trans ~ ']' }}({{- url -}}) :kissing_heart:
{# prettier-ignore-end #}
