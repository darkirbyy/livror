{% import 'theme/macro.html.twig' as m %}

<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}" style="color-scheme: dark;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {% if (turbo_force_reload|default(false)) == true %}
      <meta name="turbo-visit-control" content="reload" />
    {% endif %}
    <meta name="turbo-prefetch" content="{{ env.app.enable_prefetch ? 'true' : 'false' }}" />

    <title>
      {{ title ~ ' - ' ~ ('layout.name'|trans) }}
    </title>

    <link rel="icon" href=" {{ asset('build/logo-website.png') }}" />

    {% block stylesheets %}
      {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
      {{ encore_entry_script_tags('app') }}
    {% endblock %}
  </head>

  <body class="d-flex flex-column min-vh-100" data-bs-theme="dark">
    {# Bar not visible in prod env #}
    {% if env.app.env != 'prod' %}
      <div class="container-fluid p-0 m-0 text-center fw-bold d-flex justify-content-around app-env-{{ env.app.env }}">
        {%- for i in 1..10 -%}
          <span>{{ ('layout.env.' ~ env.app.env)|trans|upper }}</span>
        {%- endfor -%}
      </div>
    {% endif %}

    {# Skip to content link for screen reader #}
    <div class="ps-3 app-skip-link">
      <a class="icon-link visually-hidden-focusable" href="#main-content">{{ 'aria.skipToContent'|trans }}</a>
    </div>

    {# The HEADER regroup the navbar and the main title #}
    <header>
      <nav class="navbar navbar-expand-md bg-primary bg-gradient" aria-label="{{ 'aria.mainNavigation'|trans }}">
        {# Navbar with 3 blocks : the brand, the navigation button for small screen and the content #}
        <div class="container-fluid g-0">
          {# Brand #}
          <a class="navbar-brand px-2 px-md-3" href="{{ path('home_index') }}"><img src="{{ asset('build/logo-website.png') }}" alt="{{ 'layout.name'|trans }}" class="" /></a>
          {# Navigation button for small screen #}
          <button
            class="navbar-toggler m-1 border-0"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbar-supported-content"
            aria-controls="navbar-supported-content"
            aria-expanded="false"
            aria-label="{{ 'aria.toggleNavigation'|trans }}"
          >
            <span class="navbar-toggler-icon"></span>
          </button>
          {# Content as two lists : one on the left, the other on the right for lage screen / both on the top of each other for small screen #}
          <div class="collapse navbar-collapse" id="navbar-supported-content">
            {# Left part of the navbar #}
            <ul class="navbar-nav me-auto">
              {% set active = app.current_route starts with 'home' %}
              <li class="nav-item">
                <a class="nav-link {{ m.active_class(active) }}" href="{{ path('home_index') }}" {{ m.active_attr(active) }}>{{ 'layout.navbar.home'|trans }}</a>
              </li>
              {% set active = app.current_route starts with 'game' %}
              <li class="nav-item">
                <a class="nav-link {{ m.active_class(active) }}" href="{{ path('game_index') }}" {{ m.active_attr(active) }}>{{ 'layout.navbar.game'|trans }}</a>
              </li>
            </ul>
            {# Right part of the navbar #}
            <ul class="navbar-nav">
              {% set routeUuid = app.current_route_parameters.uuid|default(userConnected.uuid) %}
              {% set active = (app.current_route == 'review_index' and routeUuid.toString == userConnected.uuid.toString)
                or app.current_route == 'review_edit'
                or app.current_route == 'review_new'
              %}
              <li class="nav-item dropdown">
                <a
                  class="nav-link dropdown-toggle app-dropdown-left d-flex align-items-center {{ m.active_class(active) }}"
                  href="#"
                  role="button"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                  aria-haspopup="true"
                  {{ m.active_attr(active) }}
                >
                  <span class="me-2">{{ userConnected.username }}</span>
                  {{ m.user_avatar(userConnected) }}
                </a>
                <ul class="dropdown-menu dropdown-menu-end" role="menu">
                  <li><a class="dropdown-item py-2" role="menuitem" href="{{ path('review_index') }}">{{ 'layout.navbar.account.myReviews'|trans }}</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" role="menuitem" href="{{ env.app.iam_url }}" data-turbo-prefetch="false">{{ 'layout.navbar.account.myAccount'|trans }}</a></li>
                  <li><a class="dropdown-item" role="menuitem" href="{{ env.app.hub_url }}" data-turbo-prefetch="false">{{ 'layout.navbar.account.backToHub'|trans }}</a></li>
                  <li>
                    {# Disable turbo : we may leave this app on logout #}
                    <a class="dropdown-item text-danger" role="menuitem" href="{{ path('mainick_keycloak_security_auth_logout') }}" data-turbo-prefetch="false" data-turbo="false">
                      {{ 'layout.navbar.account.signOut'|trans }}
                    </a>
                  </li>
                </ul>
              </li>
            </ul>
          </div>
        </div>
      </nav>
      {# Main title #}
      <div class="container-fluid text-center my-4">
        <h1>{{ title }}</h1>
      </div>
    </header>

    {# The MAIN block must be redefined on each page, including the flash block with the bood wrapper #}
    <main class="flex-grow-1" role="main" id="main-content">
      {% block main %}
        {{ block('flash', 'theme/flash.html.twig') }}
        <div class="text-center">
          Some content !
        </div>
      {% endblock %}
    </main>

    {# The FOOTER divided in two part : left/right on large screen / on the top of each other on small screen #}
    <footer role="contentinfo" aria-label="{{ 'aria.footer'|trans }}">
      <div class="container-fluid fw-light bg-body-secondary bg-gradient small mt-5 py-3">
        <div class="row gw-md-4">
          {# Left part : references to frameworks #}
          <div class="col-12 col-md-6 text-center text-md-end">
            {{ 'layout.footer.madeWith'|trans }}
            <span class="fst-italic">Symfony 7 | Bootstrap 5</span>
          </div>
          {# Right part : version and update of the app #}
          <div class="col-12 col-md-6 text-center text-md-start">
            {{ ('layout.footer.version'|trans) ~ ' ' ~ env.versioning.version ~ ' - ' ~ ('layout.footer.releaseDate'|trans) ~ ' '
              ~ (env.versioning.release_date|format_datetime('short', 'none')) }}
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
