{% extends 'base.html.twig' %}
{% import 'theme/macro.html.twig' as m %}

{% set title = 'home.index.title'|trans %}

{% block main %}
  <section>
    <div class="container">
      {{ m.attachment_modal() }}

      <div class="mx-auto card-max-large card-max-md-none">
        {{ block('flash', 'theme/flash.html.twig') }}
      </div>
      {# Search part #}
      <div class="card-max-large card-max-md-extra mx-auto">
        <div class="mt-2 border border-primary rounded" {{ stimulus_controller('search-select') }}>
          <h4 class="text-center bg-primary bg-gradient p-2 mb-0">{{ 'home.index.search.title'|trans }}</h4>
          <div class="input-group p-3 bg-body-secondary" role="group" aria-label="{{ 'form.button.search'|trans }}">
            <label class="input-group-text"><span class="lnr lnr-magnifier" aria-hidden="true"></span></label>
            {% set autocomplete = prepare_attributes('global', 'game_autocomplete') %}
            <input class="form-control" type="text" {{ autocomplete|raw }} />
          </div>
        </div>
      </div>

      <div class="row my-4 pt-2 pt-md-4">
        {# Last games part #}
        <div class="col-12 col-md-6 col-lg-4 mt-4 mt-md-0">
          <h4 class="text-center pb-2">{{ 'home.index.lastGame.title'|trans }}</h4>
          {% if (gamesInfo|length) > 0 %}
            {% for gameInfo in gamesInfo %}
              {% set game = gameInfo.game %}
              {% set gameId = 'game-' ~ game.id %}

              {# One card for each game #}
              <div id="{{ gameId }}" class="card-max-large mx-auto my-3 rounded-3 border border-primary overflow-hidden">
                <div class="row py-0 g-0 px-0">
                  {# Card title : no edit buttton on home page #}
                  <div class="col-12 bg-primary bg-gradient">
                    {% set backpath = path('home_index', { anchor: gameId }) %}
                    {{ m.game_title(game, backpath, true, false) }}
                  </div>
                  {# Card image #}
                  <div class="col-12 border-bottom">
                    {{ m.game_image(game) }}
                  </div>

                  {# Card information #}
                  <div class="col-12 bg-body-secondary">
                    <div class="row p-0 m-0">
                      {{ m.game_information(game) }}
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
            {# Link to check all games list #}
            <div class="text-center p-2 p-md-4">
              <a href="{{ path('game_index') }}" class="btn btn-outline-light">{{ 'home.index.lastGame.all'|trans }}</a>
            </div>
          {% else %}
            <div class="text-center p-2 fs-5 fw-light">
              {{ 'home.index.lastGame.none'|trans }}
            </div>
          {% endif %}
        </div>

        {# Last reviews part #}
        <div class="col-12 col-md-6 col-lg-8 mt-4 mt-md-0" {{ stimulus_controller('load-popover') }}>
          <h4 class="text-center pb-2">{{ 'home.index.lastReview.title'|trans }}</h4>

          {% if (reviews|length) > 0 %}
            {% for review in reviews %}
              {% set reviewId = 'review-' ~ review.id %}

              {# One card for each review #}
              <div id="{{ reviewId }}" class="card-max-large card-max-md-none mx-auto my-3 rounded-3 border border-primary overflow-hidden">
                {# Card title bar with the the title on one side, and 3 infos on the other side (or on top of each other on small screen) #}
                <div class="row gx-0 border-bottom text-center">
                  {# Actual title without the edit button #}
                  <div class="col-12 bg-primary bg-gradient">
                    {% set backpath = path('home_index', { anchor: reviewId }) %}
                    {{ m.game_title(review.game, backpath, true, false) }}
                  </div>
                  {# 3 piece of information : player rating, hour spend, and first play date #}
                  <div class="col-12 d-flex align-items-center flex-even bg-secondary-subtle">
                    {% set popover = m.user_popover(review.user) %}
                    {% set classes = 'flex-basis-0 flex-grow-1 p-2 text-truncate d-flex justify-content-center align-items-center focus-ring lh-1 app-review-cell' %}
                    <div role="button" class="{{ classes }}" tabindex="0" data-bs-toggle="popover" data-bs-content="{{ popover|e }}">
                      {{ m.user_avatar(review.user) }}
                      <span class="ms-2 d-none d-lg-inline align-middle">{{ review.user.username }}</span>
                    </div>
                    {{ m.review_information(review, { rating: 'flex-grow-1', hourSpend: 'flex-grow-1', firstPlay: 'flex-grow-1' }) }}
                  </div>
                </div>

                {# Card body in one part : the comment #}
                <div class="p-1 bg-body-secondary">
                  {{ m.review_body(review, backpath) }}
                </div>
              </div>
            {% endfor %}
            {# Link to check all user reviews list #}
            <div class="text-center p-2 p-md-4">
              <a href="{{ path('review_index') }}" class="btn btn-outline-light">{{ 'home.index.lastReview.all'|trans }}</a>
            </div>
          {% else %}
            <div class="card-max-large mx-auto text-center my-1 p-2 fs-5 fw-light">
              {{ 'home.index.lastReview.none'|trans }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>
{% endblock %}
