{% extends 'base.html.twig' %}
{% import 'theme/macro.html.twig' as m %}

{% set title = 'home.index.title'|trans %}

{% block main %}
  <section>
    <div class="container">
      {{ block('flash', 'theme/flash.html.twig') }}

      {# Search part #}
      <div class="card-max-large card-max-md-extra mx-auto">
        <div class="mt-2 p-2 p-md-3 bg-primary-subtle rounded" {{ stimulus_controller('search-select') }}>
          <h5 class="text-center pb-2">{{ 'home.index.search.title'|trans }}</h5>
          <div class="input-group" role="group" aria-label="{{ 'form.button.search'|trans }}">
            <label class="input-group-text"><span class="bi bi-search" aria-hidden="true"></span></label>
            {% set autocomplete = prepare_attributes('global', 'game_autocomplete') %}
            <input class="form-control" type="text" {{ autocomplete|raw }} />
          </div>
        </div>
      </div>

      <div class="row my-4">
        {# Last games part #}
        <div class="col-12 col-md-6">
          <h5 class="text-center pb-2">{{ 'home.index.lastGame.title'|trans }}</h5>
          {% if (gamesInfo|length) > 0 %}
            {% for gameInfo in gamesInfo %}
              {% set game = gameInfo.game %}
              {% set gameId = 'game-' ~ game.id %}

              <div id="{{ gameId }}" class="card-max-large mx-auto my-3 rounded-3 border overflow-hidden">
                <div class="row py-0 g-0 px-0 bg-body-tertiary">
                  {# Card title : no edit buttton on home page #}
                  <div class="col-12 border-bottom bg-primary-subtle">
                    {% set backpath = path('home_index') %}
                    {{ m.game_title(game, backpath, true, false) }}
                  </div>
                  {# Card image #}
                  <div class="col-12 border-bottom">
                    {{ m.game_image(game) }}
                  </div>

                  {# Card information #}
                  <div class="col-12">
                    <div class="row p-0 m-0">
                      {{ m.game_information(game) }}
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
            {# Link to check all games list #}
            <div class="text-center p-2 p-md-4">
              <a href="{{ path('game_index') }}" class="btn btn-outline-secondary">{{ 'home.index.lastGame.all'|trans }}</a>
            </div>
          {% else %}
            <div class="text-center p-2 fs-5 fw-light">
              {{ 'home.index.lastGame.none'|trans }}
            </div>
          {% endif %}
        </div>

        {# Last reviews part #}
        <div class="col-12 col-md-6 mt-5 mt-md-0">
          <h5 class="text-center pb-2">{{ 'home.index.lastReview.title'|trans }}</h5>

          {% if (reviews|length) > 0 %}
            {% for review in reviews %}{% endfor %}
            {# Link to check all user reviews list #}
            <div class="text-center p-2 p-md-4">
              <a href="{{ path('review_index') }}" class="btn btn-outline-secondary">{{ 'home.index.lastReview.all'|trans }}</a>
            </div>
          {% else %}
            <div class="card-max-large mx-auto text-center my-1 p-2 fs-5 fw-light">
              {{ 'home.index.lastReview.none'|trans }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>
{% endblock %}
