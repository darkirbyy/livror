{% extends 'base.html.twig' %}
{% import 'theme/macro.html.twig' as m %}

{% set isOwner = app.user == user %}
{% set title = isOwner ? 'review.index.title.owner'|trans : 'review.index.title.other'|trans({ name: user.username }) %}

{% block main %}
  <section>
    <div class="container">
      {{ m.attachment_modal() }}

      {# Redefine the flashes and alert with the same width as the cards #}
      <div class="mx-auto card-max-large card-max-md-none">
        {{ block('flash', 'theme/flash.html.twig') }}
        {% if cannotAdd and isOwner %}
          <div class="alert alert-secondary" role="alert">
            {% set url = path('game_new', { backpath: path(app.current_route) }) %}
            {{ 'review.index.flash.cannotAddReview'|trans({ url: url })|raw }}
          </div>
        {% endif %}
      </div>

      {# Button to add a new review #}
      <div class="mx-auto card-max-large card-max-md-none text-center mt-2 mb-4">
        {% if isOwner %}
          <a href="{{ path('review_new') }}" class="btn btn-primary {{ cannotAdd ? 'disabled' }}" data-turbo-frame="_top" aria-label="{{ 'review.index.button.addReview'|trans }}">
            <span class="bi bi-plus-square-fill me-md-1" aria-hidden="true"></span>
            <span>{{ 'review.index.button.addReview'|trans }}</span>
          </a>
        {% else %}
          <a href="{{ path('review_index') }}" class="btn btn-outline-secondary" data-turbo-frame="_top">{{ 'review.index.button.seeMyReviews'|trans }}</a>
        {% endif %}
      </div>

      {# Turboframe to refresh only the main section when sorting the results #}
      <turbo-frame id="main-section">
        {# Number of reviews published by the current user #}
        <div class="text-start fw-light mb-2">
          {{ 'review.index.numberDisplayed'|trans({ displayed: numbers.displayed, total: numbers.total }) }}
        </div>

        {# Prepare the filters content #}
        {% set filterContentTypeGame %}
          <ul class="p-0 m-0">
            {% for typeGame in enum('App\\Enum\\TypeGameEnum').cases %}
              <li class="dropdown-item">
                {% set checked = queryParam.filters.typeGame is not defined or typeGame.value in queryParam.filters.typeGame ? 'checked' : '' %}
                {% set filtersTypeGameId = 'filters-type-game-' ~ (typeGame.value|lower) %}
                <input class="form-check-input" type="checkbox" value="{{ typeGame.value }}" id="{{ filtersTypeGameId }}" {{ checked }} data-filter-apply-target="checkbox" />
                <label class="form-check-label w-100" for="{{ filtersTypeGameId }}">{{ typeGame|trans }}</label>
              </li>
            {% endfor %}
          </ul>
        {% endset %}

        {# Include the buttons to sort, filter and reset #}
        {{ m.index_buttons(queryParam, 'review', ['name', 'rating', 'hourSpend', 'firstPlay'], { typeGame: filterContentTypeGame }) }}

        {# Include the template to render the card of each review + show more button #}
        {{ include('review/list.html.twig') }}
      </turbo-frame>
    </div>
  </section>
{% endblock %}
