{% import 'theme/macro.html.twig' as m %}

{% if (reviews|length) > 0 %}
  <div {{ stimulus_controller('load-popover') }}>
    {% for review in reviews %}
      {% set backpath = m.path_with_query_param(queryParam|clone_with({ offset: 0, limit: queryParam.limit + queryParam.offset }), 'review-' ~ review.id) %}
      {{ include('review/_card.html.twig') }}
    {% endfor %}
  </div>

  {% if hasMore %}
    {{ m.more_button(queryParam) }}
  {% endif %}
{% else %}
  <div class="card-max-large card-max-md-none mx-auto my-1 p-2 fs-5 fw-light">
    {{ 'review.index.notFound'|trans }}
  </div>
{% endif %}
