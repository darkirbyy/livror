{% import 'theme/macro.html.twig' as m %}

{% if (reviews|length) > 0 %}
  {% for review in reviews %}
    {{ include('review/show.html.twig') }}
  {% endfor %}

  {% if hasMore %}
    {{ m.more_button(queryParam) }}
  {% endif %}
{% else %}
  <div class="card-max-large card-max-md-none mx-auto my-1 p-2 fs-5 fw-light">
    {{ 'review.index.notFound'|trans }}
  </div>
{% endif %}
